services:
  # Container setting volume permissions before PHP starts
  init-permissions:
    image: alpine:3.23
    user: "0:0"
    volumes:
      - symfony_cache:/var/www/html/var/cache
      - symfony_log:/var/www/html/var/log
    command: chown -R ${HOST_UID:-1000}:${HOST_GID:-1000} /var/www/html/var/cache /var/www/html/var/log

  php:
    image: ${APP_NAME}-dev-php:${IMAGE_TAG:-local}
    build:
      context: .
      target: development
      args:
        PHP_VERSION: ${PHP_VERSION}
        HOST_UID: ${HOST_UID}
        HOST_GID: ${HOST_GID}
    user: "${HOST_UID:-1000}:${HOST_GID:-1000}"
    depends_on:
      init-permissions:
        condition: service_completed_successfully
      mailpit:
        condition: service_healthy
    volumes:
      - .:/var/www/html:cached
      - ./docker/php/dev-php.ini:/usr/local/etc/php/conf.d/zzz-dev-php.ini:ro
      - symfony_cache:/var/www/html/var/cache
      - symfony_log:/var/www/html/var/log

  nginx:
    image: nginx:${NGINX_VERSION}
    ports:
      - "${NGINX_PORT}:80"
    volumes:
      - ./docker/nginx/dev.conf:/etc/nginx/conf.d/default.conf:ro
      - .:/var/www/html:cached

  node:
    image: node:${NODE_VERSION}
    working_dir: /var/www/html
    user: "${HOST_UID:-1000}:${HOST_GID:-1000}"
    environment:
      - npm_config_cache=/tmp/.npm
      - YARN_CACHE_FOLDER=/tmp/.yarn-cache
    volumes:
      - .:/var/www/html:cached
    tty: true
    stdin_open: true

  mariadb:
    ports:
      - "3306:3306"
    healthcheck:
      interval: 1s
      timeout: 1s
      retries: 10
      start_period: 5s

  phpmyadmin:
    image: phpmyadmin:${PHPMYADMIN_VERSION}
    environment:
      PMA_HOST: mariadb
      PMA_USER: ${PMA_USER:?Missing PMA_USER}
      PMA_PASSWORD: ${PMA_PASSWORD:?Missing PMA_PASSWORD}
    depends_on:
      - mariadb
    ports:
      - "8081:80"

  mailpit:
    image: axllent/mailpit:${MAILPIT_VERSION}
    ports:
      - "8025:8025"
    volumes:
      - mailpit_data:/data
    environment:
      MP_DATABASE: /data/mailpit.db
      MP_MAX_MESSAGES: 5000

volumes:
  mailpit_data:
  symfony_cache:
  symfony_log:
