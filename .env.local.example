# Copy to .env.local and customize for your environment.

# Dev Docker image tag
IMAGE_TAG=local

# Docker user mapping
# The default value 1000:1000 works for most Linux distributions.
# Change these values if your local UID/GID differs.
# Get your values with: id -u && id -g
HOST_UID=1000
HOST_GID=1000

NGINX_PORT=8080

DEFAULT_URI=http://localhost:${NGINX_PORT}

DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@mariadb:3306/${DB_NAME}?serverVersion=${DB_VERSION}-MariaDB&charset=utf8mb4"

PMA_PASSWORD=CHANGE_ME

MAILER_DSN=smtp://mailpit:1025
